{
  "name": "@automataframework/art",
  "version": "0.0.1",
  "description": "Opt-in, build time only: turns AI-made pictures into clean pixel art in the DUEL palette. Formats may change.",
  "license": "MIT",
  "author": "McThayDT",
  "homepage": "https://automataframework.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutomataFramework/AutomataFramework.git",
    "directory": "packages/art"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "make-art": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "playwright-core": "1.65.1"
  },
  "engines": {
    "node": ">=24"
  }
}
