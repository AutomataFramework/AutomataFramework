{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [".claude/**"],
  "overrides": [
    {
      "files": ["scripts/check-commit-authors.ts"],
      "rules": {
        "no-shadow": "off",
        "no-await-in-loop": "off"
      }
    }
  ]
}
