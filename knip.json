{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/bin.ts", "tests/**/*.test.ts", "tests/**/*.spec.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
